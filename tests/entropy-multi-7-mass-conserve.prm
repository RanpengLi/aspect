set Additional shared libraries            = $ASPECT_SOURCE_DIR/benchmarks/entropy_adiabat/plugins/libentropy_plugins.so
set Dimension                              = 2
set Use years in output instead of seconds = true
set End time                               = 3e6
set Maximum time step                      = 1e5
set Output directory                       = output-free-surface-with-heat-in-equaled-gr-3
set Nonlinear solver scheme                = iterated Advection and Stokes #no Advection, no Stokes #
set Use operator splitting                 = true
set CFL number =1 #no Advection, no Stokes #
#set Nonlinear solver tolerance = 1e-8

subsection Solver parameters
  subsection Operator splitting parameters
      set Reaction solver type             = fixed step
      #set Reaction solver relative tolerance = 1e-8
      set Reaction time step               = 1e100
      set Reaction time steps per advection step = 1
  end
end
subsection Mesh deformation
  set Mesh deformation boundary indicators = top: free surface

  subsection Free surface
    set Free surface stabilization theta = 0.5
  end
end

set Surface pressure                       = 0
set Pressure normalization                 = no
#set Adiabatic surface temperature          = 1091

subsection Formulation
  set Mass conservation = projected density field
end

subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 13000
    set Y extent = 13000
    set Y repetitions = 1
  end
end

#subsection Initial temperature model
  # The actual initial temperature is irrelevant, because it
  # is recalculated from the entropy during the first timestep.
  # The value below corresponds to the entropy of 2534 J/kg/K
  # used as the top boundary condition.
